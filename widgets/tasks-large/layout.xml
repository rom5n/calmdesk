<widget xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../schemas/layout.xsd">
  <!-- Tasks are lines of a text file the title opens in Notepad; "[x] " marks done ones.
       A circle ticks its task off. -->
  <column padding="14 16" gap="8" width="fill" height="fill">
    <row width="fill" align="center" action="edit">
      <text value="{str.Tasks}" size="14" weight="700" color="accent"/>
      <spacer grow="1"/>
      <text if="app.t0" value="{app.count}" size="14" weight="700" color="accent"/>
    </row>
    <text if="!app.t0" value="{str.Click the title to add tasks}" size="13" color="secondary" width="fill"/>
    <row if="app.t0" gap="9" align="center" width="fill">
      <stack width="18" height="18" action="task:0" scale="1" pressed.scale="0.8" transition="spring">
        <ellipse if="!app.d0" width="fill" height="fill" fill="transparent" stroke="secondary" stroke-width="1.5"/>
        <ellipse if="app.d0" width="fill" height="fill" fill="accent"/>
        <image if="app.d0" src="assets/check.svg" width="12" height="12"/>
      </stack>
      <text if="!app.d0" value="{app.t0}" size="13" ellipsis="true" grow="1"/>
      <text if="app.d0" value="{app.t0}" size="13" color="secondary" ellipsis="true" grow="1"/>
    </row>
